{
  "name": "duevia-rwa",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "duevia": "bin/duevia.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "contracts:compile": "node scripts/compile-registry.mjs && node scripts/compile-guard.mjs && node scripts/compile-pool.mjs && node scripts/compile-recovery.mjs && node scripts/compile-continuity.mjs && node scripts/compile-governance.mjs && node scripts/compile-takeover.mjs",
    "contracts:test": "node scripts/run-foundry-tests.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "bench:incidents": "node scripts/run-replay-benchmarks.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.11.0",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "9.39.4",
    "@foundry-rs/cast": "^1.7.1",
    "@foundry-rs/forge": "^1.7.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "solc": "0.8.36",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "ws": "8.21.0"
  },
  "type": "module"
}
